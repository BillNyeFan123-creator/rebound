[gd_scene format=3]
; TEMPLATE: a second slime enemy for new anims/textures.
; To reskin: drop in new 32x32 spritesheets and point the four Texture2D
; ext_resources (idle / jump / get_hit / death) at them - everything else
; (animations, AI, damage, death flow) is driven by scripts/arena/Enemy.gd
; and needs no changes. Animation names must stay: idle, jump, get_hit, death.

[ext_resource type="Script" path="res://scripts/arena/Enemy.gd" id="1_enemy"]
[ext_resource type="Texture2D" path="res://scenes/Enemies/Big Slime/big_slime_idle_32x32.png" id="2_idle"]
[ext_resource type="Texture2D" path="res://scenes/Enemies/Big Slime/big_slime_jump_32x32.png" id="3_jump"]
[ext_resource type="Texture2D" path="res://scenes/Enemies/Big Slime/big_slime_get_hit_32x32.png" id="4_hit"]
[ext_resource type="Texture2D" path="res://scenes/Enemies/Big Slime/big_slime_death_32x32.png" id="5_death"]

